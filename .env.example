# SITEFLIP Environment Variables
# Copy to .env.local and fill in values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (optional — heuristic AI fallbacks used when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (optional — payments only, NOT escrow)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Future escrow (regulated third-party — do not treat Stripe as escrow)
# ESCROW_PROVIDER=
# ESCROW_API_KEY=

# Rate limiting (optional Redis/Upstash for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
