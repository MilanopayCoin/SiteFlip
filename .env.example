# SITEFLIP Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Postgres URL for migrations (never expose to client)
SUPABASE_DB_URL=
# Alternate Worker secret name accepted as alias
# SUPABASE_DB=
# Optional: enable POST /api/admin/migrate on Worker
MIGRATE_TOKEN=
SITEFLIP_ALLOW_MIGRATE=

# AI providers (optional — heuristic fallbacks when unset)
AI_PROVIDER=
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Mollie (payments only, NOT escrow)
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=

# Cloudflare (deploy / Workers)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Future escrow (regulated third-party — do not treat Mollie as escrow)
# ESCROW_PROVIDER=
# ESCROW_API_KEY=

# Rate limiting (optional Redis/Upstash for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
