# SITEFLIP Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (optional — heuristic fallbacks when unset)
AI_PROVIDER=
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Mollie (optional — payments only, NOT escrow)
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=

# Stripe (optional — payments only, NOT escrow)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare (deploy / Workers)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Future escrow (regulated third-party — do not treat Mollie/Stripe as escrow)
# ESCROW_PROVIDER=
# ESCROW_API_KEY=

# Rate limiting (optional Redis/Upstash for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
