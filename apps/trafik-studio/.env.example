# Fal.ai API key — asla commit etmeyin
EXPO_PUBLIC_FAL_KEY=

# Varsayılan: fal-ai/flux/dev/image-to-image
EXPO_PUBLIC_FAL_MODEL=fal-ai/flux/dev/image-to-image

# Kritik pozisyonları korumak için 0.78 – 0.88
EXPO_PUBLIC_IMG2IMG_STRENGTH=0.83

# Registry anahtarı (src/ai/index.ts)
EXPO_PUBLIC_AI_PROVIDER=fal-flux-dev-img2img
